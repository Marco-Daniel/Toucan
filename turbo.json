{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "stream",
  // No AGENTS.md: the repo's agent rules live in .claude/CLAUDE.md.
  "agentGuidance": false,
  // Each checkout's own cache: by default git worktrees share the main
  // checkout's, so one worktree would write into another.
  "cacheDir": ".turbo/cache",
  // Tasks see the whole environment, as they did before Turborepo: the tests
  // and scripts read HOME, PATH, CI and the qmd variables.
  "envMode": "loose",
  // Root configs every package's lint and format run reads.
  "globalDependencies": [".oxlintrc.json", ".oxfmtrc.json", ".nvmrc"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    // The extension's tests also compare its LICENSE with the root's.
    "toucan#test": {
      "dependsOn": ["^test"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/LICENSE"],
      "outputs": []
    },
    // Regenerates files and compares them with git: never cached.
    "check:generated": {
      "cache": false
    },
    "check:bundle": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "check:vsix": {
      "dependsOn": ["build"],
      "outputs": []
    },
    // The root's own tooling: docs search, docs-sync, mutate and the ADR log
    // test. It imports from the extension, uses the Vitest base and checks the
    // ADRs cited in every package, so those files count as its inputs too.
    "//#lint:repo": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "apps/extension/**",
        "config/vite/**",
        "packages/brand/**",
        "docs/adr/**"
      ],
      "outputs": []
    },
    "//#typecheck:repo": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "apps/extension/**",
        "config/vite/**",
        "packages/brand/**",
        "docs/adr/**"
      ],
      "outputs": []
    },
    "//#test:repo": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "apps/extension/**",
        "config/vite/**",
        "packages/brand/**",
        "docs/adr/**"
      ],
      "outputs": []
    }
  }
}
