{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "stream",
  // No AGENTS.md: the repo's agent rules live in .claude/CLAUDE.md.
  "agentGuidance": false,
  // Each checkout's own cache: by default git worktrees share the main
  // checkout's, so one worktree would write into another.
  "cacheDir": ".turbo/cache",
  // Tasks see the whole environment, as they did before Turborepo: the tests
  // and scripts read HOME, PATH, CI and the qmd variables.
  "envMode": "loose",
  // Root configs every package's lint and format run reads.
  "globalDependencies": [".oxlintrc.json", ".oxfmtrc.json", ".nvmrc"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    // The extension's tests also compare its LICENSE with the root's.
    "toucan#test": {
      "dependsOn": ["^test"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/LICENSE"],
      "outputs": []
    },
    // The site also reads the extension's media and imports its shared helpers by path.
    // Its build is never cached: the changelog comes from GitHub at build time.
    "@toucan/site#build": {
      "dependsOn": ["^build"],
      "cache": false
    },
    // React Router's generated route types, which lint and typecheck both read:
    // written once, before either, so they never race over the folder.
    "@toucan/site#typegen": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [".react-router/**"]
    },
    "@toucan/site#lint": {
      "dependsOn": ["^lint", "typegen"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/extension/media/**",
        "$TURBO_ROOT$/apps/extension/src/shared/**"
      ],
      "outputs": []
    },
    "@toucan/site#typecheck": {
      "dependsOn": ["^typecheck", "typegen"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/extension/media/**",
        "$TURBO_ROOT$/apps/extension/src/shared/**"
      ],
      "outputs": []
    },
    "@toucan/site#test": {
      "dependsOn": ["^test"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/extension/media/**",
        "$TURBO_ROOT$/apps/extension/src/shared/**"
      ],
      "outputs": []
    },
    // The releases package imports the extension's shared helpers by path.
    "@toucan/releases#lint": {
      "dependsOn": ["^lint"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/extension/src/shared/**"],
      "outputs": []
    },
    "@toucan/releases#typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/extension/src/shared/**"],
      "outputs": []
    },
    "@toucan/releases#test": {
      "dependsOn": ["^test"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/extension/src/shared/**"],
      "outputs": []
    },
    // Regenerates files and compares them with git: never cached.
    "check:generated": {
      "cache": false
    },
    "check:bundle": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "check:vsix": {
      "dependsOn": ["build"],
      "outputs": []
    },
    // The extension's CHANGELOG.md, from the GitHub releases: never cached, the
    // releases change without the repo changing. The VSIX check lists it.
    "toucan#changelog": {
      "cache": false,
      "outputs": ["CHANGELOG.md"]
    },
    "toucan#check:vsix": {
      "dependsOn": ["build", "changelog"],
      "outputs": []
    },
    "check:pages": {
      "dependsOn": ["build"],
      "outputs": []
    },
    // The root's own tooling: docs search, docs-sync, mutate and the ADR log
    // test. It imports from the extension, uses the Vitest base and checks the
    // ADRs cited in every package, so every package counts as its input too.
    "//#lint:repo": {
      "inputs": ["$TURBO_DEFAULT$", "apps/**", "config/**", "packages/**", "docs/adr/**"],
      "outputs": []
    },
    "//#typecheck:repo": {
      "inputs": ["$TURBO_DEFAULT$", "apps/**", "config/**", "packages/**", "docs/adr/**"],
      "outputs": []
    },
    "//#test:repo": {
      "inputs": ["$TURBO_DEFAULT$", "apps/**", "config/**", "packages/**", "docs/adr/**"],
      "outputs": []
    }
  }
}
