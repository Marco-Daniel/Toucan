{
  "name": "toucan",
  "displayName": "Toucan",
  "version": "0.0.3",
  "private": true,
  "description": "See at a glance which repository a VS Code window has open, without writing anything into the repo.",
  "categories": [
    "Other"
  ],
  "keywords": [
    "color",
    "command center",
    "peacock",
    "repository",
    "workspace"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Marco-Daniel/Toucan.git"
  },
  "publisher": "marco-daniel",
  "type": "module",
  "main": "./dist/extension.cjs",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "gen": "vscode-ext-gen --output src/generated/meta.ts",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "tsdown && vsce package --no-dependencies",
    "font": "node scripts/build-font.mts",
    "icon": "node scripts/build-icon.mts",
    "docs:index": "node scripts/qmd/docs-index.mts",
    "check:generated": "\"$npm_execpath\" gen && \"$npm_execpath\" font && \"$npm_execpath\" icon && git diff --exit-code src/generated README.md media && test -z \"$(git status --porcelain src/generated README.md media)\"",
    "check:bundle": "node scripts/check-bundle.mts",
    "check:vsix": "node scripts/check-vsix.mts",
    "prepare": "husky",
    "mutate": "node scripts/mutate.mts"
  },
  "dependencies": {
    "culori": "^4.0.2",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@stryker-mutator/core": "10.0.0",
    "@types/culori": "^4.0.1",
    "@types/node": "^22.0.0",
    "@types/vscode": "1.138.0",
    "@vscode/vsce": "^4.0.0",
    "clipper-lib": "6.4.2",
    "husky": "^9.1.7",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "svg2ttf": "^6.1.0",
    "svgicons2svgfont": "^16.0.0",
    "tsdown": "^0.23.0",
    "ttf2woff": "^3.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "vscode-ext-gen": "^1.6.0"
  },
  "contributes": {
    "configuration": {
      "title": "Toucan",
      "properties": {
        "toucan.repos": {
          "type": "object",
          "scope": "application",
          "default": {},
          "markdownDescription": "Colors per repository, keyed by workspace folder name. A value is either a color string (the Command Center background; everything else is derived) or an object with a required `background` and optional overrides.",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "description": "Background color. Any CSS color format is accepted."
              },
              {
                "type": "object",
                "required": [
                  "background"
                ],
                "additionalProperties": false,
                "properties": {
                  "background": {
                    "type": "string",
                    "description": "Command Center background color."
                  },
                  "foreground": {
                    "type": "string",
                    "description": "Command Center foreground color. Derived for contrast when omitted."
                  },
                  "activeBackground": {
                    "type": "string",
                    "description": "Command Center background on hover. Derived when omitted."
                  },
                  "activeForeground": {
                    "type": "string",
                    "description": "Command Center foreground on hover. Derived when omitted."
                  },
                  "border": {
                    "type": "string",
                    "description": "Command Center border color. Derived when omitted."
                  },
                  "activeBorder": {
                    "type": "string",
                    "description": "Command Center border on hover. Derived when omitted."
                  },
                  "inactiveForeground": {
                    "type": "string",
                    "description": "Command Center foreground when the window is inactive. Derived when omitted."
                  },
                  "inactiveBorder": {
                    "type": "string",
                    "description": "Command Center border when the window is inactive. Derived when omitted."
                  },
                  "glyph": {
                    "type": "string",
                    "default": "square",
                    "enum": [
                      "square",
                      "bar",
                      "pill",
                      "circle",
                      "toucan",
                      "sun",
                      "leaf",
                      "drop",
                      "moon",
                      "alien",
                      "ghost",
                      "robot",
                      "cat",
                      "bolt",
                      "heart",
                      "star",
                      "rocket"
                    ],
                    "description": "Shape of the status bar glyph."
                  },
                  "sidebarBlock": {
                    "type": "string",
                    "enum": [
                      "always",
                      "unfocused"
                    ],
                    "description": "Overrides `toucan.sidebarBlock.visibility` for this repository."
                  }
                }
              }
            ]
          }
        },
        "toucan.sidebarBlock.enabled": {
          "type": "boolean",
          "scope": "application",
          "default": false,
          "description": "Show a block in the repository color in the secondary sidebar."
        },
        "toucan.sidebarBlock.style": {
          "type": "string",
          "scope": "application",
          "default": "full",
          "enum": [
            "full",
            "muted"
          ],
          "enumDescriptions": [
            "Solid repository color.",
            "Faint repository color with the glyph in full color and the name in the theme's text color."
          ],
          "description": "How strongly the sidebar block is colored."
        },
        "toucan.sidebarBlock.visibility": {
          "type": "string",
          "scope": "application",
          "default": "always",
          "enum": [
            "always",
            "unfocused"
          ],
          "enumDescriptions": [
            "Reveal the block on startup. Once you close it, or switch the secondary sidebar to another view, it stays closed in this workspace until you open it again with Toucan: Toggle Sidebar Block.",
            "Reveal the block when the window loses focus and close the secondary sidebar again on focus if Toucan opened it. If another view such as Chat was open in the secondary sidebar, it is closed too."
          ],
          "description": "When the sidebar block is shown. Each repository can override this in `toucan.repos`."
        },
        "toucan.experimental.searchEmoji": {
          "type": "boolean",
          "scope": "application",
          "default": false,
          "markdownDescription": "**Experimental.** Show a colored emoji in the Command Center label. Changes `window.title` (Toucan asks first) and relies on internal VS Code behavior that may break in any release."
        }
      }
    },
    "icons": {
      "toucan-square": {
        "description": "Toucan square glyph",
        "default": {
          "fontPath": "./media/toucan-icons.woff",
          "fontCharacter": "\\E001"
        }
      },
      "toucan-bar": {
        "description": "Toucan bar glyph",
        "default": {
          "fontPath": "./media/toucan-icons.woff",
          "fontCharacter": "\\E002"
        }
      },
      "toucan-pill": {
        "description": "Toucan pill glyph",
        "default": {
          "fontPath": "./media/toucan-icons.woff",
          "fontCharacter": "\\E000"
        }
      },
      "toucan-circle": {
        "description": "Toucan circle glyph",
        "default": {
          "fontPath": "./media/toucan-icons.woff",
          "fontCharacter": "\\E003"
        }
      },
      "toucan-toucan": {
        "description": "Toucan toucan glyph",
        "default": {
          "fontPath": "./media/toucan-icons.woff",
          "fontCharacter": "\\E004"
        }
      },
      "toucan-sun": {
        "description": "Toucan sun glyph",
        "default": {
          "fontPath": "./media/toucan-icons.woff",
          "fontCharacter": "\\E005"
        }
      },
      "toucan-leaf": {
        "description": "Toucan leaf glyph",
        "default": {
          "fontPath": "./media/toucan-icons.woff",
          "fontCharacter": "\\E006"
        }
      },
      "toucan-drop": {
        "description": "Toucan drop glyph",
        "default": {
          "fontPath": "./media/toucan-icons.woff",
          "fontCharacter": "\\E007"
        }
      },
      "toucan-moon": {
        "description": "Toucan moon glyph",
        "default": {
          "fontPath": "./media/toucan-icons.woff",
          "fontCharacter": "\\E008"
        }
      },
      "toucan-alien": {
        "description": "Toucan alien glyph",
        "default": {
          "fontPath": "./media/toucan-icons.woff",
          "fontCharacter": "\\E009"
        }
      },
      "toucan-ghost": {
        "description": "Toucan ghost glyph",
        "default": {
          "fontPath": "./media/toucan-icons.woff",
          "fontCharacter": "\\E00A"
        }
      },
      "toucan-robot": {
        "description": "Toucan robot glyph",
        "default": {
          "fontPath": "./media/toucan-icons.woff",
          "fontCharacter": "\\E00B"
        }
      },
      "toucan-cat": {
        "description": "Toucan cat glyph",
        "default": {
          "fontPath": "./media/toucan-icons.woff",
          "fontCharacter": "\\E00C"
        }
      },
      "toucan-bolt": {
        "description": "Toucan bolt glyph",
        "default": {
          "fontPath": "./media/toucan-icons.woff",
          "fontCharacter": "\\E00D"
        }
      },
      "toucan-heart": {
        "description": "Toucan heart glyph",
        "default": {
          "fontPath": "./media/toucan-icons.woff",
          "fontCharacter": "\\E00E"
        }
      },
      "toucan-star": {
        "description": "Toucan star glyph",
        "default": {
          "fontPath": "./media/toucan-icons.woff",
          "fontCharacter": "\\E00F"
        }
      },
      "toucan-rocket": {
        "description": "Toucan rocket glyph",
        "default": {
          "fontPath": "./media/toucan-icons.woff",
          "fontCharacter": "\\E010"
        }
      }
    },
    "commands": [
      {
        "command": "toucan.setColor",
        "title": "Set Color for This Repo",
        "category": "Toucan"
      },
      {
        "command": "toucan.pickPreset",
        "title": "Pick Preset Color",
        "category": "Toucan"
      },
      {
        "command": "toucan.setGlyph",
        "title": "Set Glyph",
        "category": "Toucan"
      },
      {
        "command": "toucan.clearColor",
        "title": "Clear Color",
        "category": "Toucan"
      },
      {
        "command": "toucan.toggleSidebarBlock",
        "title": "Toggle Sidebar Block",
        "category": "Toucan"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "toucan.setColor",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "toucan.pickPreset",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "toucan.setGlyph",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "toucan.clearColor",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "toucan.toggleSidebarBlock",
          "when": "workspaceFolderCount > 0"
        }
      ]
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "toucan",
          "title": "Toucan",
          "icon": "$(symbol-color)"
        }
      ]
    },
    "views": {
      "toucan": [
        {
          "type": "webview",
          "id": "toucan.block",
          "name": "Toucan",
          "when": "toucan.sidebarBlockAvailable"
        }
      ]
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#56915e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.138.0"
  },
  "packageManager": "pnpm@12.8.1",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  }
}
